# =============================================================================
# Variables de Entorno - Social Debt Frontend Model (Next.js)
# =============================================================================

# Configuración General de la Aplicación
PROJECT_NAME="Social Debt Model"
API_V1_STR="/api/v1"

# Seguridad y Autenticación con el Backend
# Debe coincidir exactamente con el API_SECRET_KEY configurado en la API FastAPI
API_SECRET_KEY="super_secret_social_debt_key"

# Endpoints de Conexión a la API (FastAPI)
# API_URL: Consumido en tiempo de ejecución del servidor Next.js (Server-Side / SSR)
API_URL="http://localhost:8000/api/v1"

# NEXT_PUBLIC_API_URL: Expuesto al cliente / navegador para peticiones directas
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# -----------------------------------------------------------------------------
# Variables de Plataforma de Despliegue (Coolify / Railway / Nixpacks)
# Opcionales para entorno local; requeridas en entornos PaaS que usen Nixpacks.
# -----------------------------------------------------------------------------
# NIXPACKS_NODE_VERSION=22
